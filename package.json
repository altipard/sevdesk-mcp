{
  "name": "@altipard/sevdesk-mcp",
  "version": "0.1.0",
  "description": "Unofficial sevdesk MCP server: curated, read-only-by-default tools for the sevdesk accounting API (invoices, contacts, vouchers, banking)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altipard/sevdesk-mcp.git"
  },
  "homepage": "https://github.com/altipard/sevdesk-mcp",
  "bugs": {
    "url": "https://github.com/altipard/sevdesk-mcp/issues"
  },
  "keywords": [
    "sevdesk",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "accounting",
    "bookkeeping",
    "invoices",
    "germany",
    "buchhaltung"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "sevdesk-mcp": "dist/bin/stdio.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "build": "npm run gen && npm run build:tsc",
    "build:tsc": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run gen && npm run typecheck:tsc",
    "typecheck:tsc": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:run",
    "test:run": "vitest run --dir test",
    "test:live": "node test/live/run.mjs",
    "check": "npm run gen && npm run lint && npm run typecheck:tsc && npm run build:tsc && npm run test:run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "openapi-fetch": "0.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.4",
    "msw": "3.0.8",
    "openapi-format": "1.34.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
