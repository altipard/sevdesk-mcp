# sevdesk API token (32 hex characters, one per administrator). Optional if it is in the
# system keychain (service sevdesk-mcp, account api-token), which is read when this is unset.
SEVDESK_API_TOKEN=

# read (default), write or full.
# read:  only reading tools are registered.
# write: also drafts, master data and status changes (with confirmation step).
# full:  also irreversible actions (e-mail, cancellation, enshrine, delete),
#        each with confirmation, single use and human approval.
SEVDESK_MODE=read

# Optional whitelist of tool names (comma-separated). It only narrows the tool
# set and never switches on a tool that is off by default.
# Example: SEVDESK_ALLOWED_TOOLS=get_account_info
SEVDESK_ALLOWED_TOOLS=

# Tool names that are never registered. Always wins.
# Example: SEVDESK_DENIED_TOOLS=sevdesk_api_request
SEVDESK_DENIED_TOOLS=

# Switches on tools that are off by default: every irreversible tool (class X)
# and bulk exports. Still capped by SEVDESK_MODE. Clients that support
# elicitation still ask the user before an irreversible action; for clients
# that cannot ask, this listing counts as your explicit release.
# Unknown names stop the server at startup.
SEVDESK_ENABLE_TOOLS=

# Comma-separated sevdesk operationIds for the sevdesk_api_request fallback.
# Unset: a curated list of side-effect-free reads. Listing a write or
# irreversible operation releases it explicitly, subject to SEVDESK_MODE and
# the same confirmation rules as the tools. An irreversible operation listed
# here counts as your explicit release for clients without elicitation.
# Example: SEVDESK_API_ALLOW=getInvoices,getContacts
SEVDESK_API_ALLOW=

# HMAC key for confirmation tokens, at least 32 characters. Optional for
# stdio: without it each process draws a random key, so tokens end with the
# process. Required for the HTTP transport (several instances, restarts).
SEVDESK_CONFIRM_SECRET=

# Lifetime of a confirmation token in seconds (30-3600, default 300).
SEVDESK_CONFIRM_TTL_SECONDS=300

# Override only for tests or a non-default sevdesk instance.
SEVDESK_BASE_URL=https://my.sevdesk.de/api/v1

# debug, info (default), warn or error. Logs are JSON lines: on stderr for
# stdio (stdout carries the protocol), on stdout for HTTP. Audit events
# (every write) are written regardless of the level.
LOG_LEVEL=info

# Live smoke only (npm run test:live), never in CI: token of a sevdesk TEST
# account. The smoke always runs in read mode and prints no content.
# Unset: the smoke is skipped.
SEVDESK_LIVE_TEST_TOKEN=

# Live smoke only: optional base URL instead of the default. Accepted only as
# https on sevdesk.de or one of its subdomains, because the smoke sends the
# real token there.
SEVDESK_LIVE_BASE_URL=

# --- HTTP transport only (npm run start:http, Docker image) -----------------
# Not read by the stdio server. The HTTP server takes SEVDESK_API_TOKEN from
# the environment only (no keychain) and needs SEVDESK_CONFIRM_SECRET.

# Port to bind (default 3000).
PORT=3000

# Public URL of the MCP endpoint as clients reach it, and the audience
# (aud) access tokens must be issued for. https; http only for localhost.
# Protected Resource Metadata (RFC 9728) is served under
# /.well-known/oauth-protected-resource/<path>.
MCP_RESOURCE_URL=http://localhost:3000/mcp

# Optional Host header allowlist (comma-separated host names), e.g. behind a
# reverse proxy or load balancer. Default: the host of MCP_RESOURCE_URL.
MCP_ALLOWED_HOSTS=

# Authorization server: expected iss claim (exact string) and its public
# keys. Both https; plain http only with OAUTH_ALLOW_INSECURE_HTTP=true.
# Tokens must be JWT access tokens (typ at+jwt, RFC 9068) carrying sub, a
# client ID (client_id or azp) and the scopes sevdesk:read, sevdesk:write,
# sevdesk:irreversible. Each level needs the ones below it: issue
# sevdesk:write only together with sevdesk:read.
OAUTH_ISSUER=
OAUTH_JWKS_URL=

# Allowed JWS algorithms, comma-separated, asymmetric only (default RS256).
OAUTH_ALGORITHMS=RS256

# Local development only: accept plain http for OAUTH_ISSUER and
# OAUTH_JWKS_URL (e.g. a local identity provider in compose). Never in
# production: keys fetched over http can be swapped on the way.
OAUTH_ALLOW_INSECURE_HTTP=false

# Required for HTTP: Redis for single-use confirmation nonces and
# idempotency keys, shared by all instances. redis:// or rediss://; may
# carry a password, so treat it as a secret.
# Run it as follows, otherwise a used confirmation can become valid again:
# - persistence via AOF (appendonly yes; appendfsync always, or accept that
#   a crash can forget the last second of writes with everysec);
# - maxmemory-policy noeviction, so nonces are never evicted;
# - a Redis of its own, not a shared cache that others flush or evict.
# The server writes a sentinel key at startup. If it disappears while the
# server runs (data loss detected), confirmations (W+/X) are refused until
# the server is restarted, which sets the state anew on purpose.
REDIS_URL=redis://localhost:6379
