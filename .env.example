# sevdesk API token (32 hex characters, one per administrator). Required.
SEVDESK_API_TOKEN=

# read (default), write or full.
# read:  only reading tools are registered.
# write: also drafts, master data and status changes (with confirmation step).
# full:  also irreversible actions (e-mail, cancellation, enshrine, delete),
#        each with confirmation, single use and human approval.
SEVDESK_MODE=read

# Optional whitelist of tool names (comma-separated). It only narrows the tool
# set and never switches on a tool that is off by default.
# Example: SEVDESK_ALLOWED_TOOLS=get_account_info
SEVDESK_ALLOWED_TOOLS=

# Tool names that are never registered. Always wins.
# Example: SEVDESK_DENIED_TOOLS=sevdesk_api_request
SEVDESK_DENIED_TOOLS=

# Switches on tools that are off by default: every irreversible tool (class X)
# and bulk exports. Still capped by SEVDESK_MODE. Clients that support
# elicitation still ask the user before an irreversible action; for clients
# that cannot ask, this listing counts as your explicit release.
# Unknown names stop the server at startup.
SEVDESK_ENABLE_TOOLS=

# Comma-separated sevdesk operationIds for the sevdesk_api_request fallback.
# Unset: a curated list of side-effect-free reads. Listing a write or
# irreversible operation releases it explicitly, subject to SEVDESK_MODE and
# the same confirmation rules as the tools. An irreversible operation listed
# here counts as your explicit release for clients without elicitation.
# Example: SEVDESK_API_ALLOW=getInvoices,getContacts
SEVDESK_API_ALLOW=

# HMAC key for confirmation tokens, at least 32 characters. Optional for
# stdio: without it each process draws a random key, so tokens end with the
# process. Required for the HTTP transport (several instances, restarts).
SEVDESK_CONFIRM_SECRET=

# Lifetime of a confirmation token in seconds (30-3600, default 300).
SEVDESK_CONFIRM_TTL_SECONDS=300

# Override only for tests or a non-default sevdesk instance.
SEVDESK_BASE_URL=https://my.sevdesk.de/api/v1

# debug, info (default), warn or error. Logs go to stderr as JSON lines.
# Audit events (every write) are written regardless of the level.
LOG_LEVEL=info

# Live smoke only (npm run test:live), never in CI: token of a sevdesk TEST
# account. The smoke always runs in read mode and prints no content.
# Unset: the smoke is skipped.
SEVDESK_LIVE_TEST_TOKEN=
